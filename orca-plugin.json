{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "agent-accounts",
  "name": "Agent Accounts",
  "version": "0.2.0",
  "description": "Pick which Claude Code and Codex account each repo or workspace runs its agents on, using the accounts you added in Orca. macOS only.",
  "author": {
    "name": "AnhVanGiang",
    "url": "https://github.com/AnhVanGiang"
  },
  "repository": "https://github.com/AnhVanGiang/orca-agent-accounts",
  "license": "MIT",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "Agent Accounts panel: a workspace on one Claude account and its repo on another, plus a Codex pick"
  },
  "screenshots": [
    {
      "path": "images/panel.png",
      "alt": "The panel in dark and light themes",
      "caption": "Pick per repo, or override one workspace"
    },
    {
      "path": "images/two-repos.png",
      "alt": "Two workspaces with the same name in different repos, each with its own picker",
      "caption": "Same name in two repos: you pick, it never guesses"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "worker/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "accounts",
        "title": "Agent accounts",
        "icon": "agent",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before",
        "onError": "pass"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "commands": [
      {
        "id": "showPanel",
        "title": "Agent accounts: show panel",
        "action": "sidebar.right.toggle"
      }
    ],
    "statusBarItems": [
      {
        "id": "account",
        "icon": "agent",
        "text": "Accounts: default",
        "command": "showPanel"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:send"
    }
  ]
}
